# Copia este archivo como .env para desarrollo local o despliegue con Compose.
# Nunca confirmes el archivo .env real en Git.

# Aplicacion
NODE_ENV=production
PORT=4000

# Origen publico del panel: de aqui salen los enlaces de acceso a los portales
# que se mandan por Telegram y los origenes permitidos por CORS.
#
# Al desplegar con Docker Compose esta linea NO se aplica: compose declara
# WEB_URL en su bloque `environment`, que gana sobre este archivo. Alli hay que
# usar DOCKER_WEB_URL en el .env de la raiz.
#
# Evita puertos que los navegadores bloquean (6000, 6666, 10080 y el resto de
# la lista reservada): el portal falla con "puerto de red restringido" sin
# llegar siquiera al servidor.
WEB_URL=https://APP_DOMAIN

# PostgreSQL
# En Docker Compose usa db. Fuera de Docker usa localhost o el host correspondiente.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=colombia_sexys
DATABASE_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA
DATABASE_NAME=colombia_sexys

# Autenticacion
# Genera valores distintos, por ejemplo con: openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_SECRETO_LARGO_Y_DISTINTO
COOKIE_SECRET=REEMPLAZAR_CON_UN_SECRETO_DE_AL_MENOS_32_CARACTERES

# Usa lax cuando frontend y API se sirven bajo el mismo dominio.
# Usa none solamente si realmente son sitios distintos y ambos utilizan HTTPS.
AUTH_COOKIE_SAME_SITE=lax

# Opcional. Normalmente debe quedar vacio para cookies host-only.
# Para compartir cookies entre subdominios usa, por ejemplo: .example.com
AUTH_COOKIE_DOMAIN=

# Usuario administrador inicial
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA

# Telegram
# Un unico bot para todo: clientes, empleadas, choferes, jefes, admin y el
# onboarding de candidatas.
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_EL_TOKEN_DEL_BOT

# URL publica HTTPS del backend. Si se define, el bot usa webhooks; si queda
# vacia, cae a long polling (util en local).
# Ejemplo: https://catalogo.example.com
TELEGRAM_WEBHOOK_BASE_URL=

# Cuantas instancias del backend se arrancan. Con mas de una hay que usar
# webhook: Telegram solo admite un proceso haciendo long polling por token, y
# las demas replicas dejarian de recibir mensajes sin avisar.
APP_INSTANCE_COUNT=1

# Opcional: pagos de Telegram, si se utiliza ese flujo
TELEGRAM_PROVIDER_TOKEN=

# Proveedor de IA (xAI Grok). Puede quedar vacio si las funciones de IA no se utilizaran.
XAI_API_KEY=
GROQ_API_KEY=

# Modelo y temperatura de la IA. Se dejan vacios para usar los valores por
# defecto del codigo; existen para poder cambiar de modelo (o volver al
# anterior) sin desplegar cuando el proveedor retira una version.
AI_CHAT_MODEL=
AI_VISION_MODEL=
AI_CHAT_TEMPERATURE=

# Llamadas simultaneas al modelo (por defecto 12). Sin tope, un grupo de
# clientes escribiendo a la vez lanza todas las peticiones en paralelo y el
# proveedor responde 429 a casi todas. Las que no caben esperan turno.
AI_MAX_CONCURRENT_CALLS=

# Conexiones del pool de PostgreSQL (por defecto 30).
#
# Un turno de conversacion con la IA hace del orden de una decena de consultas,
# y varios clientes las lanzan a la vez. El limite real es `max_connections` de
# Postgres (100 de serie), que hay que repartir entre las instancias del
# backend y las migraciones.
DATABASE_POOL_MAX=

# Cloudflare R2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REEMPLAZAR_CON_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REEMPLAZAR_CON_SECRET_ACCESS_KEY
R2_BUCKET_NAME=colombia-sexys
R2_PUBLIC_URL=https://media.example.com

# Limites y configuracion operativa
MAX_DAILY_AI_CALLS=15
SCHEDULE_TRAVEL_SPEED_KMH=25
SCHEDULE_PREPARATION_MINUTES=10
ONBOARDING_SCAN_INTERVAL_MS=60000
ONBOARDING_REMINDER_HOURS=3

# Texto que se muestra al cliente para realizar transferencias.
# Evita saltos de linea sin comillas en archivos .env.
BANK_ACCOUNT_DETAILS=Banco, titular, cuenta o CLABE

# Avisos push del navegador (panel de jefe).
#
# Se generan una sola vez con `npx web-push generate-vapid-keys`. Si se dejan
# vacias el backend arranca igual y el canal push queda inactivo; lo avisa al
# iniciar. VAPID_SUBJECT es un correo de contacto que exige el protocolo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.com
