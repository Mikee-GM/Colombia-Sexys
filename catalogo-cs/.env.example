# Copia este archivo como .env.local.
# Dentro de Docker, backend es el nombre DNS del servicio de Compose.
# Para desarrollo local sin Docker usa http://localhost:4000.
BACKEND_API_URL=http://backend:4000

# Nombre publico del bot, sin arroba. Esta variable llega al navegador.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=nombre_del_bot
