# Variables consumidas por docker-compose.yml.
# Copia este archivo como .env en la raiz del monorepo.

# Dominio pendiente de definir. Se utiliza al instalar la plantilla Nginx.
APP_DOMAIN=catalogo.example.com

# Origen publico del panel y del catalogo, con esquema y sin barra final.
#
# OJO con la precedencia: docker-compose.yml declara WEB_URL en el bloque
# `environment`, que en Compose gana sobre lo que traiga `env_file`. Es decir,
# poner WEB_URL en backend/.env NO tiene efecto al desplegar con Compose: el
# valor que se aplica es este. Si se deja vacio, el backend cae a
# http://localhost:3001 y los enlaces de acceso a los portales que se mandan
# por Telegram apuntaran a esa direccion, que en el telefono de un jefe o de
# una empleada no lleva a ninguna parte.
#
# De aqui salen tambien los origenes permitidos por CORS; admite varios
# separados por comas.
DOCKER_WEB_URL=https://catalogo.example.com

# PostgreSQL
DATABASE_USER=colombia_sexys
DATABASE_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA
DATABASE_NAME=colombia_sexys

# Puerto del frontend publicado solo en loopback para Nginx.
FRONTEND_HOST_PORT=3001

# Puertos usados exclusivamente por docker-compose.dev.yml.
DATABASE_HOST_PORT=5433
BACKEND_HOST_PORT=4001

# Variable publica incorporada al build de Next.js.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=nombre_del_bot
