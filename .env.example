# Variables consumidas por docker-compose.yml.
# Copia este archivo como .env en la raiz del monorepo.

# Dominio pendiente de definir. Se utiliza al instalar la plantilla Nginx.
APP_DOMAIN=catalogo.example.com

# PostgreSQL
DATABASE_USER=colombia_sexys
DATABASE_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_SEGURA
DATABASE_NAME=colombia_sexys

# Puerto del frontend publicado solo en loopback para Nginx.
FRONTEND_HOST_PORT=3001

# Puertos usados exclusivamente por docker-compose.dev.yml.
DATABASE_HOST_PORT=5433
BACKEND_HOST_PORT=4001

# Variable publica incorporada al build de Next.js.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=nombre_del_bot
